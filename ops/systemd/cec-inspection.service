[Unit]
Description=CEC read-only native-board inspection on localhost:8091
After=network.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/home/codex/src/CEC-Platform
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /home/codex/src/CEC-Platform/scripts/cec_dashboard.py --inspection-only --no-watch --port 8091
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
