[Unit]
Description=CEC local wave-intent manager (Qwen3.5 9B Q4_K_M on CUDA)
After=network.target

[Service]
Type=simple
User=codex
Group=codex
Environment=LD_LIBRARY_PATH=/opt/cec-local-llm/bin:/usr/lib/wsl/lib
ExecStart=/opt/cec-local-llm/bin/llama-server \
  --model /var/lib/cec-local-llm/models/qwen35-9b-Q4_K_M.gguf \
  --alias cec-wave-manager \
  --host 127.0.0.1 \
  --port 8005 \
  --ctx-size 8192 \
  --gpu-layers all \
  --fit on \
  --fit-target 3072 \
  --flash-attn on \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --threads 8 \
  --threads-batch 16 \
  --parallel 1 \
  --reasoning off \
  --offline \
  --no-webui \
  --metrics \
  --log-timestamps
Restart=on-failure
RestartSec=5
TimeoutStartSec=20min
TimeoutStopSec=2min
KillMode=control-group
Nice=5
MemoryHigh=8G
MemoryMax=12G
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
