	(text "OUTPUT FORM (J4) = WORKING BASIS, not final.\nD-5a\nowner lean: very short captive stub +\norder-time\noptional extension (bundled SKU).\nSwappable section\npending the formal form\nruling -- see docs/standard-\ntier-review/\natx24-output-interface-\npanel-2026-07-03.md.\nJ4 below stays the placeholder\nmale Mini-Fit Jr\nheader (locked spec Section 2.8)\nuntil that call."
		(exclude_from_sim no)
		(at 210.82 238.76 0)
