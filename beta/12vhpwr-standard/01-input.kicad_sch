		(property "Footprint" "cec-Connector_JST:JST_PH_B3B-PH-K-S_1x03_P2.00mm_Vertical" (at 240.03 200.66 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Datasheet" "https://www.jst-mfg.com/product/pdf/eng/ePH.pdf" (at 240.03 200.66 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Manufacturer" "JST" (at 240.03 200.66 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "MPN" "B3B-PH-K-S(LF)(SN)" (at 240.03 200.66 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "LCSC" "C131339" (at 240.03 200.66 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(property "Note" "J2 fan port (beta-lock-register J-menu item 2; fan-control leg owner-ratified 2026-07-10/11). 3-pin JST-PH B3B-PH-K-S vertical, DNP posture PRESERVED from the prior 2-pin position-only provision (enclosed-menu DNP-fan provision -- not silently flipped to populated). Pin1=FAN_RET (switched GND return, through Q_FAN low-side NMOS to GND -- default-ON, firmware drives FAN_EN LOW to turn the fan off). Pin2=FAN_12V, fed from the existing pre-shunt /SENSEP6_HI node (J3 pin6 / RS6 HI terminal / R5.1 rail-divider tap) so fan draw branches off BEFORE RS6 and never adds to any per-pin GPU-side current measurement -- UNCHANGED from the prior provision, never fed from +5VSB/OQ-2 budget. Pin3=FAN_TACH, open-collector tach pulled to +3V3 (R16) and series-R'd (R17) into a free ESP32-S3 GPIO. Reference fan: Noctua NF-A4x10 FLX (12V 3-pin, 0.6W/17.9dBA/4500rpm), CONSIGNED -- mating note: JST PH is not the PC-fan KK-2510 standard, ships with a PH-crimped lead or adapter pigtail (open item)." (at 240.03 200.66 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(pin "1" (uuid "1b8bd0cc-3687-4a25-9005-73f959ecdd63"))
		(pin "2" (uuid "850df90b-4853-4eb2-9623-1955a97c1703"))
		(pin "3" (uuid "8f0f83f4-8145-4834-a04c-68e376e15c4d"))
