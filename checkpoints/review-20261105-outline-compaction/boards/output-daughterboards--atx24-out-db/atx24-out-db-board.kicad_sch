			(property "Datasheet" "" (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27))))
			(property "Description" "Generic connector, single row, 01x04 -- the four live ATX control circuits (-12V/PS_ON#/PWR_OK/GND) as a 1x4 blind-mate pair (daughterboard: right-angle pin header, pins down past the bottom edge; main board: vertical female socket, entry up). The former SR1-SR6 no-net sense-return provision pads are retired by the XFCN integration; any future remote-sense/contact-health monitor requires explicit nets, protected ADC inputs, and a defined mating path." (at 0 0 0) (show_name no) (do_not_autoplace no) (hide yes) (effects (font (size 1.27 1.27))))
