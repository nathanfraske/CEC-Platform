    (tags "resistor current-sense Bourns manufacturer-land-pattern")
    (property "Reference" "REF**"
        (at 0 -2.63 0)
        (layer "F.SilkS")
        (effects (font (size 1 1) (thickness 0.15))))
    (property "Value" "R_Bourns_CSS2H-2512R_L500"
        (at 0 2.63 0)
        (layer "F.Fab")
        (effects (font (size 1 1) (thickness 0.15))))
    (attr smd)
    
    
    (fp_rect
        (start -3.83 -1.93)
        (end 3.83 1.93)
        (stroke (width 0.05) (type solid))
        (fill no)
        (layer "F.CrtYd"))
    (fp_rect
        (start -3.15 -1.6)
        (end 3.15 1.6)
        (stroke (width 0.1) (type solid))
        (fill no)
        (layer "F.Fab"))
    (fp_text user "${REFERENCE}"
