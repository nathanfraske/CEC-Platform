id "a3872dd9-8297-515b-930e-4a9c8eb279ad") (effects (font (size 1.27 1.27)))) (property "Description" "Molex Mini-Fit Jr. 45586-series dual-row RIGHT-ANGLE header, 8 circuits (2x4), 4.20mm pitch + 5.50mm row spacing, two 3.0mm snap-in PCB-lock pegs in line with the outer pin columns. VERIFIED land from the Molex 455860005/455860105 sales-drawing ECAD export (TraceParts, 2026-06-06) -- supersedes the prior cec-derived 5569 land (wrong 5.5mm rows + oval pads). The keying/polarization is in the plastic, not the PCB pattern, so this land serves both the PCIe-keyed 45586-0005 (3rd-gen polarization) and the EPS12V-keyed sibling. Native orientation: pad1 at origin, pads 1-4 row1 (y0) / 5-8 row2 (y-4.2), pegs + body/mouth toward +y." (at 0 0 0) (layer "F.Fab") (hide yes) (uuid "9ccd2ea5-84ae-5757-8673-5d97402a374f") (effects (font (size 1.27 1.27)))) (attr through_hole) (duplicate_pad_numbers_are_jumpers no) (fp_line (start 3.221802 14.028656) (end 3.221802 0.973056) (stroke (width 0.1524) (type solid)) (layer "F.SilkS") (uuid "99cac139-52e4-5895-b723-609153877666")) (fp_line (start 3.221802 0.973056) (end 1.159687 0.973056) (stroke (width 0.1524) (type solid)) (layer "F.SilkS") (uuid "370ee132-90f5-53b1-b664-29a7cc4c1dbb")) (fp_line (start -1.159687 0.973056) (end -3.040312 0.973056) (stroke (width 0.1524) (type solid)) (layer "F.SilkS") (uuid "d253018e-2742-5862-8989-1f1b7b0b5e08")) (fp_line (start -5.359686 0.973056) (end -7.240312 0.973056) (stroke (width 0.1524) (type solid)) (layer "F.SilkS") (uuid "4f5cea89-c656-55d6-b625-aa217017fa6b")) (fp_line (start -9.559685 0.973056) (end -11.440308 0.973056) (stroke (width 0.1524) (type solid)) (layer "F.SilkS") (uuid "b6a1223c-bb20-58b7-b00d-ffb1a47cc555")) (fp_line (start -13.759682 0.973056) (end -15.421798 0.973056) (stroke (width 0.1524) (type solid)) (layer "F.SilkS") (uuid "49cf937a-a352-51e7-8e87-042b9bd9081c")) (fp_line (start -15.421798 14.028656) (end 3.221802 14.028656) (stroke (width 0.1524) (type solid)) (layer "