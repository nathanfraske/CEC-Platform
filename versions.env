# CEC platform — pinned toolchain versions. Single source of truth.
#
# Meant to be *sourced* by the scripts (it uses `: "${VAR:=default}"`, so a
# value already exported in the environment always wins over the default here).
# scripts/_common.sh and scripts/kicad-cli.sh read this; the CI workflow pins
# the same image tag (keep them in sync).
#
# The KiCad .kicad_* format is forward-only: do NOT open or save these designs
# with a different KiCad major version.

# KiCad major version is pinned. Stay on the 10.0.x stable series.
: "${KICAD_VERSION_MAJOR:=10}"
: "${KICAD_SERIES:=10.0}"

# Container image used by scripts/kicad-cli.sh and CI when no local kicad-cli is
# on PATH. Pinned to the 10.0 line.
: "${KICAD_IMAGE:=kicad/kicad:10.0}"

# Official KiCad library release that scripts/vendor-libs.sh vendors parts from.
# The kicad-symbols/footprints/packages3D repos are not yet tagged 10.0.x, so we
# pin the latest published tag (9.0.9); KiCad 10 migrates 9.x symbols on load.
# Bump to a 10.0.x tag once upstream publishes one.
: "${KICAD_LIB_TAG:=9.0.9}"

export KICAD_VERSION_MAJOR KICAD_SERIES KICAD_IMAGE KICAD_LIB_TAG

# ----------------------------------------------------------------------------
# windows-serving (gated build-out -- docs/local-compute-windows-native-migration.md)
#
# When LLM seats move off the WSL/drvfs cold-load path to a Windows-native
# llama.cpp / ik_llama.cpp server, PIN the binaries here the same as every other
# toolchain version: the upstream tag + a sha256 per binary, recorded in the eval
# records so a seat-compare result is always tied to an exact server build.
# First Windows-native seat landed 2026-06-12 (worker-vision). Mainline llama.cpp,
# CUDA 13.3 (Blackwell/sm_120). ik_llama.cpp publishes no Windows CUDA prebuilt -> the
# MoE-offload seats stay on WSL pending a from-source build (needs CUDA >= 12.8 toolkit).
: "${LLAMACPP_WIN_TAG:=b9611}"                                                      # ggml-org/llama.cpp release
: "${LLAMACPP_WIN_CUDA:=13.3}"                                                      # CUDA toolkit the build targets
: "${LLAMACPP_WIN_SERVER_SHA256:=7b7bfe262b4dd0ec7b9dc5f13286284119f5e6b20283af3e90f643cf1b42ec13}"   # llama-server.exe
: "${LLAMACPP_WIN_ZIP_SHA256:=f210b91b7ce7a60a3d9036a7d30b0ae6fedcd62be596199ea84702a45dd70a37}"       # llama-b9611-bin-win-cuda-13.3-x64.zip
# : "${IK_LLAMACPP_WIN_TAG:=}"        # no Windows CUDA prebuilt published; fill when a source build exists
export LLAMACPP_WIN_TAG LLAMACPP_WIN_CUDA LLAMACPP_WIN_SERVER_SHA256 LLAMACPP_WIN_ZIP_SHA256
