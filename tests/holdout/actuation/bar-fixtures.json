        [{"lane": "control", "influenced_by": [], "drc": 21}, {"lane": "control", "influenced_by": [], "drc": 21}, {"lane": "augmented", "influenced_by": ["rule:seed"], "drc": 15}, {"lane": "augmented", "influenced_by": ["rule:seed"], "drc": 15}]
