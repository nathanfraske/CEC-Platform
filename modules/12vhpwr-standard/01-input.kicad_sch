		(property "Note" "Fan flyback/freewheel diode -- anode on FAN_RET, cathode on FAN_12V, clamps the fan's inductive kick when Q_FAN switches off. Reuses the platform-sourced SS34 (same part as D2's USB VBUS ORing diode on this board, LCSC C8678); task spec named 'SS14' but C8678 on this board is SS34, so the already-verified-stocked part is used for BOM consistency." (at 185.42 40.64 0) (effects (font (size 1.27 1.27)) (hide yes)))
		(pin "1" (uuid "d5f00001-0000-4a2b-9c3d-4e5f6a7b8c02"))
