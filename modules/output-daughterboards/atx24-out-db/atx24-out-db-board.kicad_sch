				(hide yes)
				(effects (font (size 1.27 1.27))))
			(property "LCSC" "C86469"
				(at 0 0 0)
				(hide yes)
				(effects (font (size 1.27 1.27))))
			(property "Current Rating" "Tab-side rating is set by the mating clip/receptacle, not the tab itself; TE FASTON .250 tabs are commonly used to 20-30A class per receptacle rating (see the Keystone universal-clip Current Rating property paired with this part). No standalone UL current rating on TE's own dwg."
				(at 0 0 0)
				(hide yes)
				(effects (font (size 1.27 1.27))))
