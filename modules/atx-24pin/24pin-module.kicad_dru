(version 1)

# CEC 24-pin ATX module — custom design rules.
# KiCad auto-loads <board>.kicad_dru from the project dir. These back the
# netclasses in 24pin-module.kicad_pro: a netclass `track_width` is only the
# *routing default*, so DRC will NOT flag an under-width power trace on its own.
# The track_width (min ...) constraints below make DRC actually catch it.
#
# Sizing basis (see the layout guideline): the +5VSB node is PSU-5VSB-capped at
# ~3A; the sensed pass-through rails (RAIL*) carry tens of amps and are POURED on
# In2.Cu (2oz) — these track_width minimums are a floor that catches stray thin
# tracks, not the final pour width (zone fills are not checked by track_width).

(rule "Power min width"
	(constraint track_width (min 1.0mm))
	(condition "A.NetClass == 'Power'"))

(rule "High-current rail min track width (floor; pours exceed this)"
	(constraint track_width (min 2.5mm))
	(condition "A.NetClass == 'HighCurrent'"))

# Per-rail width floors (force/pour path), sized from the layout guideline at 2oz
# inner copper with the In1.Cu GND plane assisting (target ~20-30C rise). These
# are MINIMUMS to force a fat connection / pour; route each rail as a zone on
# In2.Cu wider than this. They supersede the 2.5mm HighCurrent baseline above for
# these specific nets. (RAIL5VSB_LO ~3A stays on the 2.5mm baseline.)
#   +12V  ~15A -> >=8mm    +5V ~20A -> >=10mm    +3.3V ~20A -> >=10mm
# NOTE: if the 2-terminal shunts move their INA sense onto these rail nets
# (pending the shunt-footprint decision), the thin Kelvin sense tap will trip
# these floors at the shunt — exclude those taps in DRC or scope a rule area.
(rule "RAIL +12V min width"
	(constraint track_width (min 8mm))
	(condition "A.NetName == 'RAIL12V_HI' || A.NetName == 'RAIL12V_LO'"))

(rule "RAIL +5V min width"
	(constraint track_width (min 10mm))
	(condition "A.NetName == 'RAIL5V_HI' || A.NetName == 'RAIL5V_LO'"))

(rule "RAIL +3.3V min width"
	(constraint track_width (min 10mm))
	(condition "A.NetName == 'RAIL3V3_HI' || A.NetName == 'RAIL3V3_LO'"))

# Keep the high-current rails clear of neighbouring copper (also set on the
# netclass; stated here so it travels with the rule file).
(rule "High-current rail clearance"
	(constraint clearance (min 0.4mm))
	(condition "A.NetClass == 'HighCurrent' && B.NetClass != 'HighCurrent'"))

# USB2.0 debug pair: keep D+/D- coupled. Full-Speed (ESP32-S3 native USB) is
# impedance-tolerant, but flag long uncoupled stretches.
(rule "USB diff pair gap"
	(constraint diff_pair_gap (min 0.1mm) (max 0.2mm))
	(condition "A.NetClass == 'USB' && B.NetClass == 'USB'"))
