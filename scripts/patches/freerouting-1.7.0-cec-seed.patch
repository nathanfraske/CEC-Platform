diff --git a/src/main/java/app/freerouting/datastructures/Seed.java b/src/main/java/app/freerouting/datastructures/Seed.java
new file mode 100644
index 0000000..d56a4a4
--- /dev/null
+++ b/src/main/java/app/freerouting/datastructures/Seed.java
@@ -0,0 +1,53 @@
+package app.freerouting.datastructures;
+
+/**
+ * CEC seed patch (base FreeRouting 1.7.0): a process-global master seed for reproducible
+ * autorouting.
+ *
+ * <p>Stock FreeRouting 1.7.0 has no way to control the pseudo-random choices its rip-up
+ * maze search makes: {@code MazeSearchAlgo} seeds its {@link java.util.Random} solely from
+ * {@code ripup_costs}, so every run explores identically (no diversity axis, R-01) and the
+ * multi-threaded optimizer's {@code Collections.shuffle} is seeded from the wall clock (a
+ * genuine run-to-run nondeterminism source). This holder lets a single {@code -seed <long>}
+ * CLI flag steer both, without threading a seed argument through the deep autoroute call
+ * chain.
+ *
+ * <p><b>Default behavior is byte-identical to stock.</b> When {@link #isSet()} is false (no
+ * {@code -seed} on the command line) {@link #mix(long)} returns its argument unchanged, so
+ * every seeded call site reduces exactly to the stock expression. The flag is purely
+ * additive; an unflagged run matches the historical baseline.
+ */
+public final class Seed {
+
+  private static boolean set = false;
+  private static long value = 0L;
+
+  private Seed() {}
+
+  /** Records the master seed from the {@code -seed} CLI flag. Idempotent per process. */
+  public static synchronized void set(long p_seed) {
+    value = p_seed;
+    set = true;
+  }
+
+  /** True once {@link #set(long)} has been called (i.e. {@code -seed} was passed). */
+  public static synchronized boolean isSet() {
+    return set;
+  }
+
+  /** The raw master seed (0 when unset). */
+  public static synchronized long value() {
+    return value;
+  }
+
+  /**
+   * Mixes the master seed into a component-local seed. Returns {@code p_local} UNCHANGED when
+   * no master seed is set, so a patched, unflagged run is byte-identical to stock. When a seed
+   * is set, the two are combined with a Fibonacci-hashing XOR so distinct master seeds yield
+   * distinct low-bit streams (what {@link java.util.Random#setSeed(long)} consumes) even for
+   * the small integer local seeds FreeRouting uses (e.g. ripup_costs).
+   */
+  public static synchronized long mix(long p_local) {
+    return set ? (p_local ^ (value * 0x9E3779B97F4A7C15L)) : p_local;
+  }
+}
