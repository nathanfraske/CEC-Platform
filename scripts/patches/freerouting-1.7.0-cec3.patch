+  /**
+   * Make a character available to the hand-written string scanner.
+   *
+   * <p>The generated DFA refills {@code zzBuffer} itself, but {@link #next_string(boolean, char)}
+   * reads that buffer directly.  On a DSN larger than the initial 512 KiB, a net token can begin at
+   * the old buffer boundary and the direct reader used to index one character past the array before
+   * the DFA had a chance to refill it.  Grow in place here so the scanner positions remain valid.
+   */
+  private boolean ensureStringInput(int index) {
+    try {
+      while (index >= zzEndRead) {
+        if (zzAtEOF) {
+          return false;
+        }
+        if (zzEndRead >= zzBuffer.length) {
+          char[] newBuffer = new char[Math.max(zzBuffer.length * 2, index + 1)];
+          System.arraycopy(zzBuffer, 0, newBuffer, 0, zzEndRead);
+          zzBuffer = newBuffer;
+        }
+        int numRead = zzReader.read(zzBuffer, zzEndRead, zzBuffer.length - zzEndRead);
+        if (numRead < 0) {
+          zzAtEOF = true;
+          return false;
+        }
+        zzEndRead += numRead;
+      }
+      return true;
+    } catch (java.io.IOException exception) {
+      throw new IllegalStateException("Unable to refill Specctra string input", exception);
+    }
+  }
