	(text "PVIN/SVIN caps + SGND/PGND/EP -> GND: generic pass, label-matched.\nEN/DLY + PG pull-up local; EN/DLY also carries the MPFS_SEQ_EN\nglobal label (03d) driving this regulator's enable -- no separate\nwire, KiCad connects same-name global_labels project-wide."
		(exclude_from_sim no)
		(at 91.44 231.14 0)
		(effects (font (size 1.27 1.27) (color 21 96 61 1)) (justify left top))
		(uuid "39b27af1-814c-4db8-9e2d-c7e89597174a")
	)
