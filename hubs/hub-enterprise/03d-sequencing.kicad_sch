	(text "GND: generic pass, label-matched. RESET (pin 2) carries the\nMPFS_SEQ_EN global label -- fans out project-wide by name to\n03a now, 03b/03c's own EN pins once those unblock (see the\nsheet-03 module docstring). VDD/sense (pin 3) = +3V3_MPFS,\nawaiting sibling leaf 03b (BLOCKED) -- pairs automatically once\n03b declares the same hier_export name, no retroactive edit here."
		(exclude_from_sim no)
		(at 128.27 186.69 0)
		(effects (font (size 1.27 1.27) (color 21 96 61 1)) (justify left top))
		(uuid "1e8c0711-3b19-48c6-b8f5-8e4aad935877")
	)
