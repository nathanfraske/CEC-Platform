	(title_block
		(title "CEC Hub Standard")
		(date "2026-07-03")
		(rev "BETA-1")
		(company "CEC")
		(comment 1 "BETA-1: A4 power-in consolidation (J_5VSB+J_5V -> J_PWR, one 3-pin JST S3B-XH-A); W12 5V-drop comparator (TLV7011, persist-on-fault interrupt, OUT -> IO14); H2 rung-3 hold-up-maximization DNP provisions (TPS61040 ~11.5V boost + TPS563201 wide-Vin buck + RJ_HOLD/RJ_BUCK jumper), position-only, all DNP. See docs/standard-tier-review/beta-splices/hub-standard.md.")
	)
