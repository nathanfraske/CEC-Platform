			(property "ki_keywords" "CEC NanoKVM aux link header UART 5V 3V3 reference presence JST-PH OQ-51"
				(id 4)
				(at 0 0 0)
				(effects (font (size 1.27 1.27)) hide)
			)
			(property "ki_description" "CEC NanoKVM aux-link header (5-pin JST-PH B5B-PH-K-S; form LOCKED spec v3.7 / OQ-51). Pin1 +5VSB shared rail (Section 2.9), pin2 GND, pin3 UART TX (Hub to NanoKVM), pin4 UART RX (NanoKVM to Hub), pin5 NanoKVM 3V3 reference/presence (untrusted - sensed ratiometrically against the Hub +3V3, never used as a reference). No trigger GPIO; event triggers ride the UART in-band."
				(id 5)
				(at 0 0 0)
				(effects (font (size 1.27 1.27)) hide)
			)
