# CEC EPS Module - default sdkconfig
# Target: ESP32-S3 N16R8 (16MB flash, 8MB octal PSRAM)

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# PSRAM - N16R8 uses octal-mode PSRAM; without this PSRAM won't initialize
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# FreeRTOS - 1ms tick for timing precision in sample/detection paths
CONFIG_FREERTOS_HZ=1000

# Task watchdog
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Console over USB-Serial-JTAG (native USB on the dev board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Custom partition table (factory app + NVS)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Compiler
CONFIG_COMPILER_OPTIMIZATION_PERF=y
